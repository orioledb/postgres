		pg_stopevent_set('step_down',
					     format('$.downlink.blkno == %s && $applicationName == "s2"',
								(SELECT blkno
								 FROM orioledb_table_pages('o_rightlink'::regclass)
					 			 WHERE rightlink IS NOT NULL))::jsonpath);

