<!--
doc/src/sgml/ref/drop_implementation.sgml
PostgreSQL documentation
-->

<refentry id="sql-drop-implementation">
 <indexterm zone="sql-drop-implementation">
  <primary>DROP IMPLEMENTATION</primary>
 </indexterm>

 <refmeta>
  <refentrytitle>DROP IMPLEMENTATION</refentrytitle>
  <manvolnum>7</manvolnum>
  <refmiscinfo>SQL - Language Statements</refmiscinfo>
 </refmeta>

 <refnamediv>
  <refname>DROP IMPLEMENTATION</refname>
  <refpurpose>remove an access method implementation</refpurpose>
 </refnamediv>

 <refsynopsisdiv>
<synopsis>
DROP IMPLEMENTATION [ IF EXISTS ] <replaceable class="parameter">name</replaceable> [, ...] [ CASCADE | RESTRICT ]
</synopsis>
 </refsynopsisdiv>

 <refsect1>
  <title>Description</title>
  <para>
   <command>DROP IMPLEMENTATION</command> removes an existing access
   method implementation.  Only superusers can drop implementations.
  </para>
 </refsect1>

 <refsect1>
  <title>Parameters</title>
  <variablelist>
   <varlistentry>
    <term><literal>IF EXISTS</literal></term>
    <listitem>
     <para>
      Do not throw an error if the implementation does not exist.  A
      notice is issued in this case.
     </para>
    </listitem>
   </varlistentry>
   <varlistentry>
    <term><replaceable class="parameter">name</replaceable></term>
    <listitem>
     <para>The name of an existing implementation.</para>
    </listitem>
   </varlistentry>
   <varlistentry>
    <term><literal>CASCADE</literal></term>
    <listitem>
     <para>
      Automatically drop objects that depend on the implementation
      (such as indexes that were created with that implementation).
     </para>
    </listitem>
   </varlistentry>
   <varlistentry>
    <term><literal>RESTRICT</literal></term>
    <listitem>
     <para>
      Refuse to drop the implementation if any objects depend on it.
      This is the default.
     </para>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1>
  <title>Compatibility</title>
  <para>
   <command>DROP IMPLEMENTATION</command> is a
   <productname>PostgreSQL</productname> extension.
  </para>
 </refsect1>

 <refsect1>
  <title>See Also</title>
  <simplelist type="inline">
   <member><xref linkend="sql-create-implementation"/></member>
   <member><xref linkend="sql-alter-implementation"/></member>
  </simplelist>
 </refsect1>
</refentry>
